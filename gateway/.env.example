# Database connection string (default SQLite for pilot, compatible with PostgreSQL)
DATABASE_URL=sqlite:///./hbk.db

# Security & Secrets
JWT_SECRET=hbk-insecure-dev-jwt-secret-replace-in-production-min-32-chars
HERMES_API_KEY=hbk-hermes-secret-key-pilot-2026
ENROLLMENT_KEY_LENGTH=16

# Monitoring, Clock & Retention Intervals
HEARTBEAT_INTERVAL_SEC=30
OFFLINE_AFTER_SEC=90
METRICS_RETENTION_DAYS=90
FBR_RETENTION_DAYS=30
EXPECTED_TIMEZONE="Pakistan Standard Time"

# Networking & CORS
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,*

# Optional Notifications
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional Dashboard Chat LLM
CHAT_LLM_BASE_URL=
CHAT_LLM_API_KEY=
CHAT_LLM_MODEL=
